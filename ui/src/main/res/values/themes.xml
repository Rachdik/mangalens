<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema dipaksa terang: warna permukaan aplikasi selalu terang, sehingga
         teks tidak boleh mengikuti mode gelap perangkat (dulu jadi putih di
         atas latar putih). -->
    <style name="Theme.MangaLens" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/mangalens_primary</item>
        <item name="colorPrimaryDark">@color/mangalens_primary_dark</item>
        <item name="colorAccent">@color/mangalens_accent</item>
        <item name="android:windowBackground">@color/mangalens_surface</item>
        <item name="android:statusBarColor">@color/mangalens_primary_dark</item>
        <item name="android:textColorPrimary">@color/mangalens_on_surface</item>
        <item name="android:textColorSecondary">@color/mangalens_muted</item>
    </style>
</resources>
